{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hostname-doctor",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://hostname-doctor.bhatnagarashwabh.workers.dev,http://localhost:5173",
    "COOKIE_DEV_MODE": "false"
  },
  "ratelimits": [
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "CONNECT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "TenantAgent", "name": "TenantAgent" },
      { "class_name": "HostnameRegistry", "name": "HostnameRegistry" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["TenantAgent", "HostnameRegistry"],
      "tag": "v1"
    }
  ],
  "workflows": [
    {
      "name": "verify-workflow",
      "binding": "VERIFY_WORKFLOW",
      "class_name": "VerifyWorkflow"
    }
  ],
  "observability": { "enabled": true }
}
